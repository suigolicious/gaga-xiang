# Copy to .env.local and fill in from the Supabase dashboard (Connect, or Settings > API Keys).
# The publishable key is safe in the app; never put the secret key (sb_secret_...) here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Development only: "true" keeps ordering for tomorrow open past the cutoff, so checkout
# can be tested at any hour. Leave it out of production builds.
EXPO_PUBLIC_IGNORE_ORDER_CUTOFF=true
